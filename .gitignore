# Generated by labmap: rebuild with check / layout / site (see README)
build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Excel lock files while a workbook is open
~$*.xlsx

# Editor and OS clutter
.claude/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# The example's reset.bat keeps the workbook it replaced here
example/lab-data.before-reset.xlsx

# Real lab data lives outside this repository. Only the empty templates are kept here, so that
# nothing filled in by accident ends up on GitHub (the example folder has its own, fictional data).
/rooms/*
!/rooms/_TEMPLATE.svg
/shapes/*
!/shapes/_TEMPLATE.svg
/sops/*
!/sops/_TEMPLATE.md
/photos/*
!/photos/README.md
/manuals/
